<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_staff_credit" model="res.groups.privilege">
        <field name="name">Staff Credit</field><field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_reader" model="res.groups">
        <field name="name">Reader</field><field name="privilege_id" ref="privilege_staff_credit"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field><field name="privilege_id" ref="privilege_staff_credit"/>
        <field name="implied_ids" eval="[(4, ref('group_reader'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_credit" model="ir.rule">
        <field name="name">Staff Credit bills by company</field><field name="model_id" ref="model_tha_staff_credit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_config" model="ir.rule">
        <field name="name">Staff Credit settings by company</field><field name="model_id" ref="model_tha_staff_credit_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_schedule" model="ir.rule">
        <field name="name">Staff Credit installments by company</field><field name="model_id" ref="model_tha_staff_credit_schedule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_allocation" model="ir.rule">
        <field name="name">Staff Credit settlements by company</field><field name="model_id" ref="model_tha_staff_credit_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_batch" model="ir.rule">
        <field name="name">Staff Credit monthly deductions by company</field><field name="model_id" ref="model_tha_staff_credit_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_operation" model="ir.rule">
        <field name="name">Staff Credit operations by company</field><field name="model_id" ref="model_tha_staff_credit_operation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

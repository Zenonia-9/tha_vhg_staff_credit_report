<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="native_staff_credit_report" model="account.report">
        <field name="name">Staff Credit Report</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="filter_show_draft" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_journals" eval="False"/>
        <field name="filter_analytic" eval="False"/>
        <field name="filter_hide_0_lines">never</field>
        <field name="default_opening_date_filter">this_month</field>
        <field name="search_bar" eval="True"/>
        <field name="custom_handler_model_id" ref="model_tha_staff_credit_report_handler"/>
        <field name="column_ids">
            <record id="native_column_date" model="account.report.column"><field name="name">Date</field><field name="expression_label">date</field><field name="figure_type">date</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_staff" model="account.report.column"><field name="name">Staff</field><field name="expression_label">staff</field><field name="figure_type">string</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_department" model="account.report.column"><field name="name">Department</field><field name="expression_label">department</field><field name="figure_type">string</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_description" model="account.report.column"><field name="name">Patient / Other charge</field><field name="expression_label">description</field><field name="figure_type">string</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_amount" model="account.report.column"><field name="name">100% Bill</field><field name="expression_label">amount</field><field name="figure_type">monetary</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_prior" model="account.report.column"><field name="name">Prior settlements</field><field name="expression_label">prior</field><field name="figure_type">monetary</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_balance" model="account.report.column"><field name="name">Balance before month deductions</field><field name="expression_label">balance</field><field name="figure_type">monetary</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_planned" model="account.report.column"><field name="name">Monthly planned</field><field name="expression_label">planned</field><field name="figure_type">monetary</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_times" model="account.report.column"><field name="name">Times</field><field name="expression_label">times</field><field name="figure_type">string</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_actual" model="account.report.column"><field name="name">Monthly actual</field><field name="expression_label">actual</field><field name="figure_type">monetary</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_closing" model="account.report.column"><field name="name">Closing balance</field><field name="expression_label">closing</field><field name="figure_type">monetary</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_remark" model="account.report.column"><field name="name">Remark</field><field name="expression_label">remark</field><field name="figure_type">string</field><field name="blank_if_zero" eval="False"/></record>
            <record id="native_column_reference" model="account.report.column"><field name="name">System reference</field><field name="expression_label">reference</field><field name="figure_type">string</field><field name="blank_if_zero" eval="False"/></record>
        </field>
    </record>
    <record id="action_native_monthly_report" model="ir.actions.client">
        <field name="name">Staff Credit Report</field>
        <field name="tag">account_report</field>
        <field name="path">staff-credit-monthly</field>
        <field name="context" eval="{'report_id': ref('native_staff_credit_report')}"/>
        <field name="params" eval="{'ignore_session': True}"/>
    </record>
    <menuitem id="menu_monthly_report" name="Monthly Report" parent="menu_staff_credit"
              action="action_native_monthly_report" sequence="20" groups="group_reader"/>
    <template id="native_pdf_layout" inherit_id="account_reports.pdf_export_main" primary="True">
        <xpath expr="//table/colgroup" position="replace">
            <colgroup>
                <col style="width:6%"/><col style="width:5%"/><col style="width:8%"/>
                <col style="width:7%"/><col style="width:13%"/><col style="width:6%"/>
                <col style="width:6%"/><col style="width:6%"/><col style="width:6%"/>
                <col style="width:3%"/><col style="width:6%"/><col style="width:6%"/>
                <col style="width:15%"/><col style="width:7%"/>
            </colgroup>
        </xpath>
    </template>
</odoo>

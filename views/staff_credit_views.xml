<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_credit_list" model="ir.ui.view">
        <field name="name">tha.staff.credit.list</field><field name="model">tha.staff.credit</field>
        <field name="arch" type="xml">
            <list string="Staff Credit Report" decoration-muted="balance == 0" import="1">
                <header>
                    <button name="%(action_export)d" type="action" string="Export Excel" display="always"/>
                    <button name="%(action_deductions)d" type="action" string="Generate Monthly Deductions" groups="tha_vhg_staff_credit_report.group_manager"/>
                    <button name="action_settings" type="object" string="Settings" display="always" context="{'tha_staff_credit_company_settings': True}" groups="tha_vhg_staff_credit_report.group_manager"/>
                </header>
                <field name="name"/><field name="charge_date"/><field name="employee_id"/><field name="department_id"/>
                <field name="description"/><field name="source_move_id"/><field name="amount"/>
                <field name="settled_amount" sum="Settled"/><field name="balance" sum="Balance"/>
                <field name="company_id" groups="base.group_multi_company"/><field name="currency_id" column_invisible="True"/>
                <field name="stage" string="State" widget="badge" decoration-info="stage == 'draft'"
                       decoration-success="stage in ('posted', 'repaid')" decoration-danger="stage == 'cancel'"/>
            </list>
        </field>
    </record>
    <record id="view_credit_form" model="ir.ui.view">
        <field name="name">tha.staff.credit.form</field><field name="model">tha.staff.credit</field>
        <field name="arch" type="xml">
            <form string="Staff Credit Bill">
                <header>
                    <button name="action_create_original_invoice" type="object" string="Create Draft Invoice" class="btn-primary" groups="tha_vhg_staff_credit_report.group_manager,account.group_account_user" invisible="state != 'draft' or invoice_id"/>
                    <button name="action_post_staff_credit" type="object" string="Post Staff Credit" class="btn-primary" groups="tha_vhg_staff_credit_report.group_manager" invisible="state != 'draft' or not invoice_id or invoice_state != 'posted'" confirm="Post this Staff Credit entry using the linked posted customer invoice?"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" groups="tha_vhg_staff_credit_report.group_manager,account.group_account_user" invisible="state != 'cancel' or not invoice_id"/>
                    <button name="action_generate_schedule" type="object" string="Generate Repayment Plan" class="btn-primary" groups="tha_vhg_staff_credit_report.group_manager" confirm="Replace the unused plan with equal monthly installments?" invisible="state != 'posted' or schedule_ids"/>
                    <button name="%(action_export)d" type="action" string="Export Excel" context="{'default_mode': 'export', 'active_model': 'tha.staff.credit', 'active_id': id, 'tha_from_credit_form': True}" invisible="state != 'posted'"/>
                    <button name="%(action_deductions)d" type="action" string="Generate Monthly Deductions" groups="tha_vhg_staff_credit_report.group_manager" invisible="state != 'posted'"/>
                    <button name="action_settings" type="object" string="Settings" groups="tha_vhg_staff_credit_report.group_manager"/>
                    <field name="stage" string="State" widget="statusbar" statusbar_visible="draft,posted,repaid,cancel"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group string="Bill link">
                            <field name="company_id"/><field name="invoice_id" string="Customer invoice"
                                options="{'no_create': True, 'no_create_edit': True}"
                                readonly="state != 'draft'"/>
                            <field name="invoice_state" invisible="1"/>
                            <field name="source_move_id" options="{'no_create': True}" invisible="state != 'posted'"/>
                            <field name="source_line_selection_required" invisible="1"/>
                            <field name="source_line_id" options="{'no_create': True}" invisible="not source_line_selection_required" force_save="1"/>
                            <field name="charge_date"/><field name="partner_id"/><field name="amount"/>
                            <field name="anzer_reference"/><field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Staff and repayment">
                            <field name="employee_id" domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
                            <field name="department_id"/><field name="category"/><field name="description"/>
                            <field name="start_month"/><field name="installment_count"/><field name="end_date"/>
                            <field name="settled_amount"/><field name="balance"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Repayment plan">
                            <p>One installment per month. Move an unused installment to skip a month. Generated drafts reserve the amount; only posted entries count as settlement.</p>
                            <field name="schedule_ids">
                                <list editable="bottom">
                                    <field name="due_date" readonly="locked"/>
                                    <field name="amount" readonly="locked" sum="Planned"/>
                                    <field name="deduction_line_ids" widget="many2many_tags" readonly="1" string="Generated deduction"/>
                                    <field name="locked" string="Deduction created" readonly="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Generated deductions">
                            <field name="deduction_line_ids" readonly="1">
                                <list create="0" delete="0" no_open="1">
                                    <field name="move_id" widget="many2one" options="{'no_create': True}"/>
                                    <field name="date"/>
                                    <field name="parent_state"/><field name="debit"/><field name="credit"/>
                                    <button name="tha_action_open_staff_credit_line" type="object" string="Details" icon="fa-info-circle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Existing settlements">
                            <p>Link historical repayments or adjustments here. Deductions generated by this module are counted automatically and cannot be linked again.</p>
                            <field name="allocation_ids">
                                <list editable="bottom">
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="source_line_id" options="{'no_create': True}"/><field name="move_id"/>
                                    <field name="date"/><field name="kind"/><field name="amount" sum="Settlements"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes and authorization">
                            <group><field name="authorizer_id"/><field name="authorization_date"/></group>
                            <field name="remark" string="Note" placeholder="Add a note for this staff credit report…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_credit_search" model="ir.ui.view">
        <field name="name">tha.staff.credit.search</field><field name="model">tha.staff.credit</field>
        <field name="arch" type="xml">
            <search>
            <field name="name"/><field name="employee_id"/><field name="department_id"/>
            <field name="source_move_id"/><field name="anzer_reference"/><field name="description"/><field name="category"/>
            <filter name="staff" string="Staff" context="{'group_by': 'employee_id'}"/>
            <filter name="department" string="Department" context="{'group_by': 'department_id'}"/>
        </search></field>
    </record>
    <record id="view_config_form" model="ir.ui.view">
        <field name="name">tha.staff.credit.config.form</field><field name="model">tha.staff.credit.config</field>
        <field name="arch" type="xml">
            <form string="Staff Credit Settings">
            <group><field name="company_id"/>
                <field name="account_id" domain="[('company_ids', 'in', company_id), ('account_type', '=', 'asset_receivable'), ('reconcile', '=', True)]"/>
                <field name="salary_account_id" domain="[('company_ids', 'in', company_id), ('account_type', 'in', ['expense', 'expense_direct_cost', 'asset_cash'])]"/>
                <field name="invoice_credit_account_id" domain="[('company_ids', 'in', company_id), ('account_type', 'in', ['income', 'income_other'])]"/>
                <field name="journal_id"/>
            </group>
        </form></field>
    </record>
    <record id="view_settings_wizard_form" model="ir.ui.view">
        <field name="name">tha.staff.credit.settings.wizard.form</field><field name="model">tha.staff.credit.settings.wizard</field>
        <field name="arch" type="xml">
            <form string="Staff Credit Settings">
                <group><field name="company_id"/><field name="credit_id" invisible="1"/>
                    <field name="account_id" domain="[('company_ids', 'in', company_id), ('account_type', '=', 'asset_receivable'), ('reconcile', '=', True)]"/>
                    <field name="salary_account_id" domain="[('company_ids', 'in', company_id), ('account_type', 'in', ['expense', 'expense_direct_cost', 'asset_cash'])]"/>
                    <field name="journal_id" domain="[('company_id', '=', company_id), ('type', '=', 'general')]"/>
                    <field name="invoice_credit_account_id" domain="[('company_ids', 'in', company_id), ('account_type', 'in', ['income', 'income_other'])]"/>
                    <field name="save_as_default"/>
                </group>
                <footer><button name="action_apply" type="object" string="Apply to this bill" class="btn-primary"/><button string="Cancel" special="cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="action_credit" model="ir.actions.act_window">
        <field name="name">Staff Credit Report</field><field name="res_model">tha.staff.credit</field>
        <field name="view_mode">list,form</field><field name="path">staff-credit-report</field>
    </record>
    <menuitem id="menu_staff_credit_report" name="Staff Credit Report" parent="tha_vhg_daily_cash_register.menu_other_reports"
              action="action_credit" sequence="30" groups="tha_vhg_staff_credit_report.group_reader"/>
</odoo>

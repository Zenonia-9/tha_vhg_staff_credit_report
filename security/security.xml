<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="privilege_staff_credit" model="res.groups.privilege"><field name="name">Staff Credit</field><field name="category_id" ref="base.module_category_accounting"/></record>
 <record id="group_reader" model="res.groups"><field name="name">Reader</field><field name="privilege_id" ref="privilege_staff_credit"/><field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/></record>
 <record id="group_manager" model="res.groups"><field name="name">Manager</field><field name="privilege_id" ref="privilege_staff_credit"/><field name="implied_ids" eval="[(4, ref('group_reader'))]"/><field name="user_ids" eval="[(4, ref('base.user_admin'))]"/></record>
 <record id="rule_tha_staff_credit" model="ir.rule"><field name="name">Staff Credit company: charge</field><field name="model_id" ref="model_tha_staff_credit"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>

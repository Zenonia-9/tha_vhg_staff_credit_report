<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_monthly_report" model="ir.ui.view">
        <field name="name">tha.staff.credit.report.form</field><field name="model">tha.staff.credit.report</field>
        <field name="arch" type="xml">
        <form string="Monthly Staff Credit">
            <header>
                <button name="action_preview" string="Refresh report" type="object" class="btn-primary"/>
                <button name="action_excel" string="Excel" type="object"/>
                <button name="action_pdf" string="PDF" type="object"/>
            </header>
            <sheet>
                <group>
                    <group><field name="company_id"/><field name="month"/><field name="status"/></group>
                    <group><field name="employee_id" domain="[('company_id', '=', company_id)]"/><field name="department_id"/><field name="category"/></group>
                </group>
                <div class="alert alert-info" role="status">Select a month and refresh after changing filters. The monthly column is the planned deduction. Times counts fully paid installments through the previous month. GL totals below always cover the whole company/account.</div>
                <notebook>
                    <page string="Staff report">
                        <field name="line_ids" readonly="1"><list create="0" delete="0">
                            <field name="credit_id"/><field name="date"/><field name="staff"/><field name="department"/>
                            <field name="description"/><field name="amount" sum="Charges" string="100% Bill"/>
                            <field name="prior" sum="Prior settlements" string="Settled before month"/>
                            <field name="balance" sum="Balance" string="Before month deductions"/>
                            <field name="planned" sum="Planned"/><field name="times"/>
                            <field name="actual" sum="Actual"/><field name="closing" sum="Closing"/>
                            <field name="remark"/><field name="reference"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list></field>
                    </page>
                    <page string="Company GL reconciliation">
                        <group>
                            <group><field name="opening"/><field name="charges"/><field name="reductions"/><field name="closing"/></group>
                            <group><field name="gl_balance"/><field name="difference"/><field name="unlinked_debits"/><field name="unapplied_credits"/></group>
                        </group>
                        <p>GL balance minus register closing = unlinked debits minus unapplied credits. Review every difference before relying on a complete staff breakdown.</p>
                        <field name="audit_ids" readonly="1"><list create="0" delete="0">
                            <field name="source_line_id"/><field name="date"/><field name="reference"/>
                            <field name="partner"/><field name="debit" sum="Unlinked debits"/><field name="credit" sum="Unapplied credits"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list></field>
                    </page>
                </notebook>
                <field name="currency_id" invisible="1"/>
            </sheet>
        </form></field>
    </record>
    <record id="action_monthly_report" model="ir.actions.act_window">
        <field name="name">Monthly Staff Credit Report</field><field name="res_model">tha.staff.credit.report</field>
        <field name="view_mode">form</field>
    </record>
    <menuitem id="menu_monthly_report" name="Monthly Report" parent="menu_staff_credit" action="action_monthly_report" sequence="20"/>
    <record id="view_suggestions" model="ir.ui.view">
        <field name="name">tha.staff.credit.suggestion.form</field><field name="model">tha.staff.credit.suggestion</field>
        <field name="arch" type="xml">
        <form string="Review settlement suggestions">
            <p>These are unallocated credits reconciled against the charge. Check amounts and classify adjustments/reversals before confirming.</p>
            <field name="credit_id" readonly="1"/>
            <field name="line_ids"><list editable="bottom" create="0" delete="0">
                <field name="selected"/><field name="source_line_id" readonly="1"/>
                <field name="amount"/><field name="kind"/><field name="currency_id" column_invisible="True"/>
            </list></field>
            <footer><button name="action_confirm" string="Confirm allocations" type="object" class="btn-primary"/><button string="Cancel" special="cancel"/></footer>
        </form></field>
    </record>
</odoo>
